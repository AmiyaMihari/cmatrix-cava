#!/usr/bin/env python3
"""Lluvia estilo cmatrix con el degradado de ~/.config/cava/config.

Abajo usa gradient_color_1 y arriba el último, igual que las barras de cava.
Salir con q, Esc o Ctrl+C. -u N ajusta la velocidad como en cmatrix (0-10).
"""
import argparse
import os
import random
import re
import select
import shutil
import signal
import sys
import termios
import tty

CHARS = [chr(c) for c in range(33, 127)]
DEFAULT_COLORS = ['#94e2d5', '#89dceb', '#74c7ec', '#89b4fa',
                  '#cba6f7', '#f5c2e7', '#eba0ac', '#f38ba8']


def load_colors():
    try:
        with open(os.path.expanduser('~/.config/cava/config')) as f:
            text = f.read()
    except OSError:
        return DEFAULT_COLORS
    found = {}
    for m in re.finditer(r"^\s*gradient_color_(\d+)\s*=\s*['\"]?(#[0-9a-fA-F]{6})", text, re.M):
        found[int(m.group(1))] = m.group(2)
    colors = [found[k] for k in sorted(found)]
    return colors if len(colors) >= 2 else DEFAULT_COLORS


def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def gradient(colors, t):
    """t=0 es abajo (primer color), t=1 arriba (último color)."""
    pos = t * (len(colors) - 1)
    i = min(int(pos), len(colors) - 2)
    f = pos - i
    a, b = colors[i], colors[i + 1]
    return tuple(round(a[k] + (b[k] - a[k]) * f) for k in range(3))


class Rain:
    def __init__(self, colors):
        self.colors = colors
        self.resize()

    def resize(self):
        self.cols, self.rows = shutil.get_terminal_size()
        rows = self.rows
        self.trail = []
        self.head = []
        for y in range(rows):
            t = 1 - y / max(rows - 1, 1)
            r, g, b = gradient(self.colors, t)
            color = f'38;2;{r};{g};{b}'
            self.trail.append((f'\x1b[0;{color}m', f'\x1b[0;1;{color}m'))
            # Cabeza: el color de la fila mezclado con blanco, como el blanco de cmatrix
            hr, hg, hb = (round(c + (255 - c) * 0.7) for c in (r, g, b))
            self.head.append(f'\x1b[0;1;38;2;{hr};{hg};{hb}m')
        self.chars = [[' '] * self.cols for _ in range(rows)]
        self.xs = list(range(0, self.cols, 2))
        self.speed = {x: random.choice((0.5, 0.75, 1.0)) for x in self.xs}
        # Cada stream: [cabeza (float), largo]; arrancan escalonados por encima de la pantalla
        self.streams = {x: [[-random.randint(0, rows), random.randint(4, max(5, rows - 3))]]
                        for x in self.xs}
        self.out = ['\x1b[0m\x1b[2J']

    def put(self, x, y, ch, style):
        self.chars[y][x] = ch
        self.out.append(f'\x1b[{y + 1};{x + 1}H{style}{ch}')

    def step(self):
        rows = self.rows
        for x in self.xs:
            streams = self.streams[x]
            speed = self.speed[x]
            for s in streams:
                old = int(s[0])
                s[0] += speed
                for y in range(old + 1, int(s[0]) + 1):
                    if 0 <= y - 1 < rows:
                        prev = self.chars[y - 1][x]
                        if prev != ' ':
                            self.put(x, y - 1, prev, self.trail[y - 1][random.random() < 0.5])
                    if 0 <= y < rows:
                        self.put(x, y, random.choice(CHARS), self.head[y])
                    tail = y - s[1]
                    if 0 <= tail < rows:
                        self.put(x, tail, ' ', '')
            streams[:] = [s for s in streams if s[0] - s[1] < rows]
            last = streams[-1] if streams else None
            if last is None or (last[0] - last[1] > random.randint(1, rows // 2 + 1)
                                and random.random() < 0.08):
                streams.append([-1.0, random.randint(4, max(5, rows - 3))])

    def flush(self):
        if self.out:
            os.write(sys.stdout.fileno(), ''.join(self.out).encode())
            self.out = []


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('-u', type=int, default=4, choices=range(0, 11), metavar='0-10',
                        help='retardo entre cuadros, como cmatrix (default 4)')
    args = parser.parse_args()
    delay = max(args.u, 1) * 0.01

    resized = False

    def on_winch(*_):
        nonlocal resized
        resized = True

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGWINCH, on_winch)
    signal.signal(signal.SIGTERM, on_term)

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    os.write(sys.stdout.fileno(), b'\x1b[?1049h\x1b[?25l')
    try:
        tty.setcbreak(fd)
        rain = Rain([hex_rgb(c) for c in load_colors()])
        while True:
            if resized:
                resized = False
                rain.resize()
            rain.step()
            rain.flush()
            ready, _, _ = select.select([fd], [], [], delay)
            if ready and os.read(fd, 32)[:1] in (b'q', b'Q', b'\x1b'):
                break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        os.write(sys.stdout.fileno(), b'\x1b[0m\x1b[?25h\x1b[?1049l')


if __name__ == '__main__':
    main()
